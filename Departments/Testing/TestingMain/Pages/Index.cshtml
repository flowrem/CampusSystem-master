@page
@model IndexModel
@{
    ViewData["Title"] = "Datastore Test Console";
}

<div class="container mt-4" style="max-width: 1100px;">
    <div class="card mb-4">
        <div class="card-body">
            <h2>Shared JSON datastore</h2>
            <p class="text-muted mb-1">File: <code>@Model.FilePath</code> &middot; schema version @Model.SchemaVersion</p>
            <p class="text-muted">Every department app reads and writes this file. Edits made here are live.</p>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")" role="alert">@Model.Message</div>
            }

            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="Collection">Collection</label>
                    <select id="Collection" name="Collection" class="form-select" onchange="this.form.submit()">
                        @foreach (var collection in Model.Collections)
                        {
                            <option value="@collection.Name" selected="@(collection.Name == Model.Collection)">@collection.Name (@collection.Count)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-secondary w-100">Refresh</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.View is { } view)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h3>Add a row to @view.Name</h3>
                <form method="post" asp-page-handler="Add">
                    <input type="hidden" name="Collection" value="@view.Name" />
                    <textarea asp-for="NewRowJson" class="form-control mb-3" rows="4" placeholder='{"name": "Test", "email": "test@example.com"}'></textarea>
                    <p class="text-muted small">An id is assigned if the row has none.</p>
                    <button type="submit" class="btn btn-primary w-100">Add row</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h3>@view.Name</h3>

                @if (view.Rows.Count > 0)
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-striped table-bordered align-middle">
                            <thead>
                                <tr>
                                    @foreach (var column in view.Columns)
                                    {
                                        <th>@column</th>
                                    }
                                    <th style="width: 220px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < view.Rows.Count; i++)
                                {
                                    var rowId = view.Ids[i];
                                    var modalId = $"editRowModal_{i}";
                                    <tr>
                                        @foreach (var cell in view.Rows[i])
                                        {
                                            <td style="max-width:260px; overflow-wrap:anywhere;">@cell</td>
                                        }
                                        <td>
                                            @if (rowId is null)
                                            {
                                                <span class="text-muted small">No numeric id</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-warning me-2" data-bs-toggle="modal" data-bs-target="#@modalId">Edit</button>
                                                <form method="post" asp-page-handler="DeleteRow" class="d-inline">
                                                    <input type="hidden" name="rowId" value="@rowId" />
                                                    <input type="hidden" name="Collection" value="@view.Name" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this row from the shared datastore?');">Delete</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>

                                    @if (rowId is not null)
                                    {
                                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                <div class="modal-content">
                                                    <form method="post" asp-page-handler="UpdateRow">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Edit @view.Name #@rowId</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="rowId" value="@rowId" />
                                                            <input type="hidden" name="Collection" value="@view.Name" />
                                                            @for (var c = 0; c < view.Columns.Count; c++)
                                                            {
                                                                var readOnly = view.Columns[c] == "id";
                                                                <div class="mb-3">
                                                                    <label class="form-label">@view.Columns[c]</label>
                                                                    <input type="text" class="form-control" name="@view.Columns[c]" value="@view.Rows[i][c]" readonly="@readOnly" />
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary">Save changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3">This collection has no rows.</p>
                }
            </div>
        </div>
    }
</div>
