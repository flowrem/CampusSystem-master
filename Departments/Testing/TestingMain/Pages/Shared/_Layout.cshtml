<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Testing · NU Lipa</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/CampusSystem.Ui/css/campus-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestingMain.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="campus-shell">
        <aside class="campus-sidebar">
            <a class="campus-brand" asp-page="/Index">NU Lipa<small>Testing Console</small></a>
            <nav aria-label="Primary"><ul class="campus-nav"><li><a asp-page="/Index">Collections</a></li><li><a asp-page="/Privacy">Privacy</a></li><li><a href="/ChangePassword">Password</a></li></ul></nav>
        </aside>
        <div class="campus-main">
            <header class="campus-topbar"><div class="campus-user"><strong>@User.Identity?.Name</strong>Administrator</div><a class="btn btn-sm btn-outline-primary" href="/Logout">Sign out</a></header>
            <main class="campus-content" role="main">@RenderBody()</main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
