@page
@model FacultyPortalMain.Pages.ScheduleModel
@{
    ViewData["Title"] = "My Teaching Schedule";
    ViewData["ActivePage"] = "Schedule";
}

<div class="portal-page-header">
    <div>
        <div class="portal-eyebrow">Faculty Academic Load</div>
        <h1 class="portal-page-title">Teaching Schedule</h1>
        <p class="portal-page-subtitle">Official semestral schedule &middot; AY 2025-2026 &middot; 1st Semester &middot; Synchronized with University Registrar</p>
    </div>
    <div style="display:flex;gap:8px;">
        <button type="button" onclick="window.print()" class="btn-nu btn-nu-outline">🖨️ Print Schedule</button>
        <a href="/Roster" class="btn-nu btn-nu-gold">👥 View Class Rosters</a>
    </div>
</div>

<div class="portal-card">
    <div class="portal-card-header">
        <h3 class="portal-card-title"><span>📅</span> Assigned Class Offerings</h3>
        <span class="badge-status badge-secondary">@Model.Classes.Count Assigned Sections</span>
    </div>
    <div class="portal-table-responsive">
        <table class="portal-table">
            <thead>
                <tr>
                    <th>Day(s)</th>
                    <th>Time</th>
                    <th>Section &amp; Course Code</th>
                    <th>Subject Description</th>
                    <th>Units</th>
                    <th>Room</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Classes)
                {
                    <tr>
                        <td class="cell-title">
                            <strong>@(string.IsNullOrEmpty(c.DaysOfWeek) ? "M-W-F" : c.DaysOfWeek)</strong>
                        </td>
                        <td style="font-weight:600;color:var(--nu-blue);">
                            @(string.IsNullOrEmpty(c.StartTime) ? "08:00 AM" : c.StartTime) – @(string.IsNullOrEmpty(c.EndTime) ? "10:00 AM" : c.EndTime)
                        </td>
                        <td>
                            <code style="font-weight:700;color:var(--nu-blue);background:#f0f4ff;padding:2px 8px;border-radius:4px;">
                                @c.SectionCode
                            </code>
                        </td>
                        <td>
                            <div style="font-weight:700;">@c.SubjectCode</div>
                            <div style="font-size:12px;color:var(--nu-text-muted);">@c.SubjectName</div>
                        </td>
                        <td>@c.Units.0</td>
                        <td><span class="badge-status badge-info">@(string.IsNullOrEmpty(c.Room) ? "Rm 204" : c.Room)</span></td>
                        <td style="text-align:center;">
                            <a href="/Roster?sectionId=@c.Id" class="btn-nu btn-nu-outline" style="padding:4px 10px;font-size:11.5px;text-decoration:none;">
                                👥 Roster (@c.EnrolledCount)
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Classes.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:36px;color:var(--nu-text-muted);">
                            No class offerings found for this semester.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
