@page
@model FacultyPortalMain.Pages.AssignmentsModel
@{
    ViewData["Title"] = "Assignments";
    ViewData["ActivePage"] = "Assignments";
}

<div class="portal-page-header">
    <div>
        <div class="portal-eyebrow">Coursework</div>
        <h1 class="portal-page-title">Assignments</h1>
        <p class="portal-page-subtitle">Create assignments and activities, set due dates, and grade student work. Students see an assignment once it is published.</p>
    </div>
    <div class="page-actions">
        <a href="#create" class="btn-nu btn-nu-gold">＋ New assignment</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="portal-card" style="margin-bottom:16px;border-left:4px solid @(Model.IsError ? "#dc2626" : "#15803d");">
        <div class="portal-card-body" style="padding:12px 16px;font-weight:600;color:@(Model.IsError ? "#b91c1c" : "#15803d");">@Model.Message</div>
    </div>
}

<div class="stat-grid">
    <div class="stat-card"><div class="stat-label">Published</div><div class="stat-value">@Model.PublishedCount</div><div class="stat-subtext">Visible to students</div></div>
    <div class="stat-card gold-border"><div class="stat-label">To grade</div><div class="stat-value">@Model.ToGradeCount</div><div class="stat-subtext">Submissions waiting for a score</div></div>
    <div class="stat-card info-border"><div class="stat-label">Due this week</div><div class="stat-value">@Model.DueThisWeek</div><div class="stat-subtext">Published and closing soon</div></div>
    <div class="stat-card green-border"><div class="stat-label">Drafts</div><div class="stat-value">@Model.DraftCount</div><div class="stat-subtext">Not yet published</div></div>
</div>

<div class="portal-card">
    <div class="portal-card-header"><h3 class="portal-card-title"><span>📝</span> Your assignments</h3></div>
    <form method="get" class="toolbar">
        <select name="sectionId" class="form-select" aria-label="Section" onchange="this.form.submit()">
            <option value="">All sections</option>
            @foreach (var sec in Model.Sections)
            {
                <option value="@sec.Id" selected="@(Model.SectionFilter == sec.Id)">@sec.SectionCode — @sec.SubjectCode</option>
            }
        </select>
        <select name="status" class="form-select" aria-label="Status" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var status in new[] { "Draft", "Published", "Closed" })
            {
                <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
            }
        </select>
        <input type="text" name="q" value="@Model.Search" class="form-control" placeholder="Search by title" aria-label="Search assignments" />
        <button type="submit" class="btn-nu btn-nu-outline btn-sm">Search</button>
    </form>
    <div class="portal-table-responsive">
        <table class="portal-table">
            <thead>
                <tr><th>Title</th><th>Section</th><th>Type</th><th>Due</th><th class="num">Submitted</th><th class="num">Graded</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assignments)
                {
                    <tr>
                        <td><div class="cell-title">@a.Title</div><div class="cell-sub">Max score @a.MaxScore.ToString("0.##")</div></td>
                        <td>@a.SectionCode</td>
                        <td>@a.Type</td>
                        <td>@(a.DueDate is { } due ? due.ToString("MMM d, yyyy · h:mm tt") : "Not set")</td>
                        <td class="num">@a.Submitted / @a.Enrolled</td>
                        <td class="num">@a.Graded</td>
                        <td><span class="@AssignmentsModel.BadgeClass(a.Status)">@a.Status</span></td>
                        <td><a href="/AssignmentDetail?id=@a.Id" class="btn-nu btn-nu-outline btn-sm">@(a.Status == "Closed" ? "Open" : "Open / edit")</a></td>
                    </tr>
                }
                @if (Model.Assignments.Count == 0)
                {
                    <tr><td colspan="8" class="muted" style="text-align:center;padding:28px;">No assignments yet. Create one below.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="portal-card" id="create">
    <div class="portal-card-header"><h3 class="portal-card-title"><span>＋</span> New assignment</h3></div>
    <form method="post" asp-page-handler="Create" class="portal-card-body">
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" for="title">Title</label>
                <input id="title" name="title" class="form-control" required maxlength="200" />
            </div>
            <div class="form-group">
                <label class="form-label" for="offeringId">Section</label>
                <select id="offeringId" name="offeringId" class="form-select" required>
                    @foreach (var sec in Model.Sections)
                    {
                        <option value="@sec.Id">@sec.SectionCode — @sec.SubjectCode</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="type">Type</label>
                <select id="type" name="type" class="form-select">
                    @foreach (var type in FacultyPortalMain.Services.CourseworkStore.Types)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="dueDate">Due date</label>
                <input id="dueDate" name="dueDate" type="datetime-local" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label" for="maxScore">Maximum score</label>
                <input id="maxScore" name="maxScore" type="number" min="1" max="1000" step="1" value="100" class="form-control" required />
            </div>
        </div>
        <div class="form-group">
            <label class="form-label" for="instructions">Instructions</label>
            <textarea id="instructions" name="instructions" class="form-control" rows="5" maxlength="10000"></textarea>
        </div>
        <div class="card-footer-actions">
            <label style="display:flex;gap:8px;align-items:center;"><input type="checkbox" name="publish" value="true" /> Publish now (needs a due date)</label>
            <button type="submit" class="btn-nu btn-nu-gold">Save assignment</button>
        </div>
    </form>
</div>
