<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NU Lipa Campus System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/finance-pages.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="fin-body">
    <div class="fin-gold-bar"></div>
    <div class="fin-shell">
        <!-- Sidebar -->
        <aside class="fin-sidebar">
            <div class="fin-sidebar-brand">
                <svg class="fin-sidebar-crest" width="32" height="32" viewBox="0 0 34 34" fill="none">
                    <path d="M17 2 L30 7 V16 C30 24 24 30 17 32 C10 30 4 24 4 16 V7 Z" fill="#eab308" stroke="#0d1b3d" stroke-width="1.5" />
                    <text x="17" y="21" text-anchor="middle" font-size="11" font-weight="800" fill="#0d1b3d">NU</text>
                </svg>
                <div>
                    <div class="fin-sidebar-brand-name">CAMPUS SYSTEM</div>
                    <div class="fin-sidebar-brand-sub">National University Lipa</div>
                </div>
            </div>
            <nav class="fin-sidebar-nav">
                <div class="fin-nav-group">Faculty Portal</div>
                <a class="fin-nav-link" href="http://localhost:5115/">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7l6-5 6 5" /><path d="M4 6.5V13a1 1 0 001 1h6a1 1 0 001-1V6.5" /></svg>
                    Dashboard
                </a>
                <a class="fin-nav-link" href="http://localhost:5115/Roster">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="4.5" r="2.5" /><path d="M3 13c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5" /></svg>
                    My Classes
                </a>
                <a class="fin-nav-link" href="http://localhost:5115/Schedule">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="11" rx="1.5" /><path d="M2 6.5h12M5 2v3M11 2v3" /></svg>
                    Schedule
                </a>

                <div class="fin-nav-group">Finance</div>
                <a class="fin-nav-link @(ViewData["Title"]?.ToString() == "Student Clearance Status" ? "active" : "")" href="/FacultyClearance">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2l5 2v4c0 4-2.5 5.5-5 6-2.5-.5-5-2-5-6V4z" /><path d="M6 8l1.5 1.5L10 6.5" /></svg>
                    Clearance
                </a>

                <div class="fin-nav-group">Academics</div>
                <a class="fin-nav-link" href="http://localhost:5115/Gradebook">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 3h8v10l-4-2-4 2z" /></svg>
                    Grades
                </a>
            </nav>
            <div class="fin-sidebar-footer">
                <div class="fin-sidebar-avatar fin-avatar-faculty">@(ViewData["FacultyInitials"] ?? "FA")</div>
                <div>
                    <div class="fin-sidebar-footer-name">@(ViewData["FacultyName"] ?? "Faculty Member")</div>
                    <div class="fin-sidebar-footer-role">Faculty</div>
                </div>
                <a href="/Logout" style="margin-left:auto;font-size:11.5px;color:#cbd5e1;text-decoration:none;" title="Sign out">Sign out</a>
            </div>
        </aside>

        <!-- Main content -->
        <main class="fin-main">
            <div class="fin-statusbar">
                <div class="fin-pill">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="#64748b" stroke-width="1.5"><rect x="2" y="3" width="12" height="11" rx="1.5" /><path d="M2 6.5h12M5 2v3M11 2v3" /></svg>
                    AY 2026-2027 &middot; 1st Semester
                </div>
                <div class="fin-pill-live">
                    <span class="dot"></span>
                    System Live
                </div>
                <div class="flex-grow-1"></div>
                <a href="http://localhost:5115" class="fin-pill" style="text-decoration:none; color:var(--fin-navy); font-size:11px;">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7l6-5 6 5"/><path d="M4 6.5V13a1 1 0 001 1h6a1 1 0 001-1V6.5"/></svg>
                    Faculty Portal
                </a>
                <div class="fin-officer" style="border-left: none; padding-left: 0;">
                    <svg width="26" height="26" viewBox="0 0 16 16" fill="#cbd5e1"><circle cx="8" cy="5.5" r="3" /><path d="M2.5 14c0-3 2.5-5 5.5-5s5.5 2 5.5 5" /></svg>
                    <div>
                        <div class="fin-officer-name">@(ViewData["FacultyName"] ?? "Faculty Member")</div>
                        <div class="fin-officer-role">Faculty</div>
                    </div>
                </div>
            </div>
            <div class="fin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
