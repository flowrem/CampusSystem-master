@page
@model FinanceMain.Pages.StudentAccountModel
@{
    ViewData["Title"] = "My Account";
    Layout = "_FinanceStudentLayout";
}

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="fin-card h-100" style="padding:22px;">
            <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;">
                <div class="fin-avatar">
                    @string.Join("", Model.StudentName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]))
                </div>
                <div style="flex:1;min-width:200px;">
                    <div class="fin-name">@Model.StudentName</div>
                    <div style="font-size:12.5px;color:var(--fin-muted);margin-top:2px;">
                        <strong>ID:</strong> @Model.StudentId &middot; @Model.Program &middot; AY @Model.Term
                    </div>
                </div>
                <div style="text-align:right;">
                    <div class="fin-stat-label">Clearance Status</div>
                    <span class="@FinanceMain.Pages.StudentAccountModel.ClearanceBadgeClass(Model.ClearanceStatus)" style="font-size:13px;padding:5px 14px;">
                        @FinanceMain.Pages.StudentAccountModel.ClearanceDisplayText(Model.ClearanceStatus)
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="fin-balance-card h-100" style="padding:22px;display:flex;flex-direction:column;justify-content:center;">
            <div class="fin-stat-label" style="color:#94a3b8;">Outstanding Balance</div>
            <div class="fin-balance-amount" style="margin-top:4px;">@Model.OutstandingBalance.ToString("₱#,##0.00")</div>
            <div style="margin-top:14px;display:flex;gap:8px;">
                @if (Model.OutstandingBalance > 0)
                {
                    <a href="/Pay" class="btn-fin-gold" style="flex:1;justify-content:center;">💳 Pay Balance Online</a>
                }
                else
                {
                    <span class="badge-status badge-status-paid" style="font-size:12px;padding:6px 14px;">✓ Full Tuition Settled</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Fee Breakdown -->
    <div class="col-lg-8">
        <div class="fin-card">
            <div class="fin-card-head">
                <span class="fin-card-head-title">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2h8v12l-2-1-2 1-2-1-2 1V2z"/><path d="M6 5h4M6 8h4"/></svg>
                    Assessment Itemized Breakdown
                </span>
                <a href="/OAO" target="_blank" class="btn-fin-outline" style="font-size:12px;padding:5px 12px;">
                    🖨️ Official Assessment Order (OAO)
                </a>
            </div>
            <div class="table-responsive">
                <table class="fin-table">
                    <thead>
                        <tr>
                            <th>Fee Description</th>
                            <th style="text-align:right;">Amount</th>
                            <th style="text-align:right;">Paid / Credited</th>
                            <th style="text-align:right;">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasAssessment)
                        {
                            @foreach (var fee in Model.FeeBreakdown)
                            {
                                <tr>
                                    <td style="font-weight:600;">@fee.Name</td>
                                    <td style="text-align:right;">@fee.Amount.ToString("₱#,##0.00")</td>
                                    <td style="text-align:right;color:var(--fin-green);font-weight:600;">@fee.Paid.ToString("₱#,##0.00")</td>
                                    <td style="text-align:right;" class="@(fee.Balance == 0 ? "fin-balance-ok" : "fin-balance-due")">
                                        @fee.Balance.ToString("₱#,##0.00")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" style="text-align:center;color:var(--fin-muted);padding:36px;">No fee assessment on file for this term yet.</td></tr>
                        }
                    </tbody>
                    @if (Model.HasAssessment)
                    {
                        <tfoot>
                            <tr style="font-weight:800;background:#fafbfc;border-top:2px solid var(--fin-border);">
                                <td>Total Matriculation &amp; Fees</td>
                                <td style="text-align:right;">@Model.TotalAmount.ToString("₱#,##0.00")</td>
                                <td style="text-align:right;color:var(--fin-green);">@Model.TotalPaid.ToString("₱#,##0.00")</td>
                                <td style="text-align:right;" class="@(Model.TotalBalance == 0 ? "fin-balance-ok" : "fin-balance-due")">
                                    @Model.TotalBalance.ToString("₱#,##0.00")
                                </td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: Financial Aid + Payment History -->
    <div class="col-lg-4 d-flex flex-column gap-3">
        <!-- Financial Aid -->
        <div class="fin-card" style="padding:18px;">
            <div class="fin-card-head-title" style="margin-bottom:12px;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="6" r="3.5"/><path d="M6 9l-1.5 5L8 12l3.5 2L10 9"/></svg>
                Scholarship &amp; Grants
            </div>
            <div class="fin-aid-box">
                <div style="font-weight:700;color:var(--fin-green);font-size:13px;">@Model.AidName</div>
                <div style="font-size:11.5px;color:var(--fin-muted);margin-top:2px;">@Model.AidDescription</div>
                <div class="fin-aid-amount">–@Model.AidAmount.ToString("₱#,##0.00")</div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px;margin-top:8px;">
                <span style="color:var(--fin-muted);">Grant Status</span>
                <span class="badge-status badge-status-paid" style="font-size:11px;">✓ @Model.AidStatus</span>
            </div>
        </div>

        <!-- Payment History -->
        <div class="fin-card flex-grow-1">
            <div class="fin-card-head">
                <span class="fin-card-head-title">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="12" height="8" rx="1"/><path d="M2 7h12"/></svg>
                    Payment History
                </span>
                <span class="fin-card-badge">@Model.PaymentHistory.Count Receipts</span>
            </div>
            <div style="padding:0;">
                @if (Model.PaymentHistory.Any())
                {
                    <table class="fin-table">
                        <tbody>
                            @foreach (var p in Model.PaymentHistory)
                            {
                                <tr>
                                    <td>
                                        <div class="fin-mono">
                                            <a href="/Receipt?paymentNumber=@p.PaymentNumber" target="_blank" class="fin-link" title="Print Official Receipt">
                                                @p.PaymentNumber 🧾
                                            </a>
                                        </div>
                                        <div style="font-size:11px;color:var(--fin-muted);margin-top:2px;">@p.Date &middot; @p.Method</div>
                                    </td>
                                    <td style="text-align:right;font-weight:700;color:var(--fin-green);">
                                        @p.Amount.ToString("₱#,##0.00")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center;color:var(--fin-muted);font-size:12px;padding:24px;">No payments recorded yet.</div>
                }
            </div>
        </div>
    </div>
</div>
