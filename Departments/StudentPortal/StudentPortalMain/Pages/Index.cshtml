@page
@model IndexModel
@{
    ViewData["Title"] = "Student Portal";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">Campus Services</div>
        <h1>Student Portal</h1>
    </div>
</section>

<div class="surface p-4 p-md-5">
    <p class="lead mb-4">Support student tasks for schedules, requests, and academic information from a single portal view.</p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Student actions</h2>
                <ul class="mb-0">
                    <li>Profile overview</li>
                    <li>Schedule access</li>
                    <li>Request center</li>
                    <li>Grades and records</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Portal status</h2>
                <p class="mb-0">This portal is intentionally set up as a front-end design layer while the data and authorization layers are being finalized.</p>
            </div>
        </div>
    </div>
</div>
