@inject StudentPortalMain.Services.StudentPortalDbService Db
@{
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Student Portal";

    // Read student identity from session — no DB call needed here
    var sessionStudentId = Context.Session.GetInt32("student_user_id") ?? 0;
    var studentName = Context.Session.GetString("student_name") ?? "Student";
    var studentNumber = Context.Session.GetString("student_id_number") ?? "";

    var studentInitials = string.Join("", studentName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));

    // Profile & term fetched for sidebar display
    var profile = await Db.GetStudentProfileAsync(sessionStudentId);
    var term = await Db.GetActiveTermAsync();

    var flashMessage = TempData["FlashMessage"]?.ToString();
    var flashType = TempData["FlashType"]?.ToString() ?? "success";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@pageTitle - National University Lipa Student Portal</title>
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true">
</head>
<body class="portal-body">

    <!-- ─── Sidebar Navigation ──────────────────────────────────────────────── -->
    <aside class="portal-sidebar">
        <div class="portal-brand">
            <img src="~/img/logo3.png" alt="National University Logo" class="brand-crest" />
            <div class="brand-title-wrap">
                <div class="brand-main-title">STUDENT PORTAL</div>
                <div class="brand-sub-title">National University Lipa</div>
            </div>
        </div>

        <div class="student-card-mini">
            <div class="student-avatar">@studentInitials</div>
            <div class="student-details">
                <div class="student-name" title="@studentName">@studentName</div>
                <div class="student-id-num">@studentNumber</div>
                <div class="student-prog" title="@profile.Program">@profile.Program (@profile.YearLevel)</div>
            </div>
        </div>

        <nav class="portal-nav">
            <div class="nav-category">Academic &amp; Registrar</div>
            <a href="/Dashboard" class="@(activePage == "Dashboard" ? "active" : "")">
                <span class="nav-ic">🏠</span> Dashboard
            </a>
            <a href="/Schedule" class="@(activePage == "Schedule" ? "active" : "")">
                <span class="nav-ic">📅</span> My Schedule &amp; Classes
            </a>
            <a href="/Grades" class="@(activePage == "Grades" ? "active" : "")">
                <span class="nav-ic">📊</span> Grades &amp; Record
            </a>
            <a href="/Enrollment" class="@(activePage == "Enrollment" ? "active" : "")">
                <span class="nav-ic">📝</span> Enrollment &amp; COR
            </a>
            <a href="/DocumentRequests" class="@(activePage == "DocumentRequests" ? "active" : "")">
                <span class="nav-ic">📄</span> Documents &amp; 201 Vault
            </a>
            <a href="/Coursework" class="@(activePage == "Coursework" ? "active" : "")">
                <span class="nav-ic">📂</span> Coursework &amp; Tasks
            </a>

            <div class="nav-category" style="margin-top:10px;">Campus Departments</div>
            <a href="/Financials" class="@(activePage == "Financials" ? "active" : "")">
                <span class="nav-ic">💳</span> Tuition &amp; Finance
            </a>
            <a href="/Clearance" class="@(activePage == "Clearance" ? "active" : "")">
                <span class="nav-ic">🛡️</span> Semestral Clearance
            </a>
            <a href="/Library" class="@(activePage == "Library" ? "active" : "")">
                <span class="nav-ic">📚</span> Library &amp; Books
            </a>
            <a href="/Scholarships" class="@(activePage == "Scholarships" ? "active" : "")">
                <span class="nav-ic">🎓</span> Scholarships
            </a>
            <a href="/Requests" class="@(activePage == "Requests" ? "active" : "")">
                <span class="nav-ic">🧭</span> Guidance Requests
            </a>
            <a href="/Profile" class="@(activePage == "Profile" ? "active" : "")">
                <span class="nav-ic">👤</span> Profile &amp; Settings
            </a>
        </nav>

        <div class="portal-sidebar-footer">
            <div>NU Lipa Collegiate System</div>
            <div style="color:var(--nu-gold); margin-top:2px;">AY @term.SchoolYear &middot; @term.Semester</div>
        </div>
    </aside>

    <!-- ─── Main View Shell ─────────────────────────────────────────────────── -->
    <div class="portal-main">
        <header class="portal-topbar">
            <div class="topbar-left">
                <span class="term-pill">📅 AY @term.SchoolYear &middot; @term.Semester</span>
                <span class="conn-status-pill">
                    <span class="pulse-dot"></span> Registrar Connected
                </span>
                <span class="conn-status-pill" style="margin-left:6px;">
                    <span class="pulse-dot" style="background:var(--nu-gold);"></span> Finance System Live
                </span>
            </div>

            <div class="topbar-right" style="display:flex; align-items:center; gap:12px;">
                <div style="font-size:12px; color:var(--nu-text-muted); display:flex; align-items:center; gap:6px;">
                    <span style="font-weight:700; color:var(--nu-blue-dark);">@studentName</span>
                    @if (!string.IsNullOrEmpty(studentNumber))
                    {
                        <span style="background:var(--nu-surface-alt); border:1px solid var(--nu-border); border-radius:4px; padding:2px 8px; font-size:11px; font-weight:600;">@studentNumber</span>
                    }
                </div>

                <a href="/Logout" class="btn-nu" style="background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; padding:6px 12px; font-size:12px; text-decoration:none; display:flex; align-items:center; gap:6px; border-radius:6px; font-weight:700;">
                    <span>🚪</span> Sign Out
                </a>
            </div>
        </header>

        <div class="portal-content">
            @if (!string.IsNullOrEmpty(flashMessage))
            {
                <div class="alert-banner alert-@flashType">
                    <span>@flashMessage</span>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
