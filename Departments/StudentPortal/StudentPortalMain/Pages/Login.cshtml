@page
@model StudentPortalMain.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Student Sign In";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Student Sign In - National University Lipa</title>
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true">
    <style>
        body {
            background: linear-gradient(135deg, #001f3f 0%, #082d56 50%, #001730 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .login-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 440px;
            padding: 36px 32px;
            box-sizing: border-box;
        }
        .brand-header {
            text-align: center;
            margin-bottom: 28px;
        }
        .brand-logo {
            width: 72px;
            height: 72px;
            object-fit: contain;
            margin-bottom: 12px;
        }
        .brand-title {
            font-size: 20px;
            font-weight: 800;
            color: #002366;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .brand-sub {
            font-size: 13px;
            color: #64748b;
            margin-top: 2px;
        }
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 6px;
        }
        .form-control {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 14px;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }
        .form-control:focus {
            outline: none;
            border-color: #002366;
            box-shadow: 0 0 0 3px rgba(0,35,102,0.1);
        }
        .btn-submit {
            background: #002366;
            color: #ffffff;
            border: none;
            padding: 12px;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 700;
            width: 100%;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 10px;
        }
        .btn-submit:hover {
            background: #0a3580;
        }
        .error-box {
            background: #fee2e2;
            border: 1px solid #fca5a5;
            color: #991b1b;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            margin-bottom: 16px;
        }
        .registrar-note {
            font-size: 12px;
            color: #64748b;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 12px 14px;
            margin-top: 24px;
            line-height: 1.5;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="brand-header">
        <img src="~/img/logo3.png" alt="National University Logo" class="brand-logo" onerror="this.style.display='none'" />
        <div class="brand-title">Student Portal</div>
        <div class="brand-sub">National University Lipa</div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-box">
            <span>⚠️</span> @Model.ErrorMessage
        </div>
    }

    @if (TempData["FlashMessage"] != null)
    {
        <div style="background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; padding:10px 14px; border-radius:6px; font-size:13px; margin-bottom:16px;">
            ✓ @TempData["FlashMessage"]
        </div>
    }

    <form method="post">
        <div style="margin-bottom: 16px;">
            <label class="form-label">Student ID Number or University Email</label>
            <input type="text" asp-for="Identifier" class="form-control" placeholder="e.g. 2023-01045 or email@students.nulipa.edu.ph" required autofocus />
        </div>

        <div style="margin-bottom: 22px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <label class="form-label" style="margin-bottom:0;">Password</label>
            </div>
            <input type="password" asp-for="Password" class="form-control" placeholder="••••••••••••" required />
        </div>

        <button type="submit" class="btn-submit">
            Sign In to Portal
        </button>
    </form>

    <div class="registrar-note">
        🏛️ <strong>Registrar Integrated:</strong> Student accounts are provisioned upon enrollment by the <strong>University Registrar</strong>. Use your official student credentials to access your portal.
    </div>
</div>

</body>
</html>
