@page
@model CatalogModel
@{
    ViewData["Title"] = "Catalog";
}

<div class="page-heading"><div><span class="eyebrow">Library workspace</span><h1>Catalog search</h1><p class="text-muted">Find books by title, author, ISBN or call number.</p></div></div>

<partial name="_Flash" model="Model" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input class="form-control" name="q" value="@Model.Q" placeholder="Search catalog" /></div>
    <div class="col-md-3">
        <select class="form-select" name="category">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category" selected="@(Model.Category == category)">@category</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-center"><label class="form-check-label"><input type="checkbox" class="form-check-input me-1" name="availableOnly" value="true" checked="@Model.AvailableOnly" />Available now</label></div>
    <div class="col-md-2"><button class="btn btn-dark w-100">Search</button></div>
</form>

<div class="surface p-0">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Title</th><th>Author</th><th>Category</th><th>Shelf</th><th class="text-end">Copies</th><th></th></tr></thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td><a asp-page="/Resource" asp-route-id="@book.Id"><strong>@book.Title</strong></a><div class="small text-muted">@book.CallNumber</div></td>
                        <td>@book.Author</td>
                        <td>@book.Category</td>
                        <td class="small">@book.Shelf</td>
                        <td class="text-end">
                            @if (book.Available > 0) { <span class="badge text-bg-success">@book.Available of @book.Total available</span> }
                            else { <span class="badge text-bg-secondary">None available</span> }
                        </td>
                        <td class="text-end"><a asp-page="/Resource" asp-route-id="@book.Id" class="btn btn-sm btn-outline-dark">Details</a></td>
                    </tr>
                }
                @if (Model.Books.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted p-4">No catalog results.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
