@page
@{ ViewData["Title"] = "Records Requests"; }
<div class="registrar-page" data-page="records">
<section class="page-heading"><div><span class="eyebrow">Request tracker</span><h1>Records requests</h1><p class="page-intro">Request official documents and follow their status from one place.</p></div></section>
<section class="request-layout"><div class="surface request-form"><span class="eyebrow">New request</span><h2>What do you need?</h2><label for="document-type" class="form-label">Document type</label><select id="document-type" class="form-select mb-3"><option value="COR">Certificate of Registration</option><option value="COE">Certificate of Enrollment</option><option value="Good Moral">Good moral certificate</option></select><button type="button" class="btn btn-primary" id="records-submit">Submit request</button></div><div class="surface request-history"><div class="panel-heading"><div><span class="eyebrow">History</span><h2>Your requests</h2></div></div><div id="records-list" class="stack-list"><div class="loading-state">Loading requests<span class="loading-dots">...</span></div></div></div></section>
<div class="alert alert-danger d-none" data-error role="alert"></div><div class="alert alert-success d-none" data-success role="status"></div>
</div>