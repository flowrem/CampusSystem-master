{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "GeneralRules": [
      { "Endpoint": "*:POST:/auth/login", "Period": "1m", "Limit": 10 },
      { "Endpoint": "*:POST:/auth/refresh", "Period": "1m", "Limit": 20 }
    ]
  }
}
